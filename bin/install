#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

# Visual formatting helpers
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${GREEN}==================================================${NC}"
echo -e "${GREEN}        Tarantula Web Crawler Installer           ${NC}"
echo -e "${GREEN}==================================================${NC}"

# 1. Detect Operating System and install dependencies
OS="$(uname -s)"
echo -e "Detecting operating system... ${YELLOW}$OS${NC}"

case "$OS" in
    Linux)
        if [ -f /etc/debian_version ]; then
            echo -e "Debian/Ubuntu detected. Installing build essentials and ncurses headers..."
            apt-get update
            apt-get install -y build-essential libncurses-dev git
        elif [ -f /etc/fedora-release ]; then
            echo -e "Fedora detected. Installing development tools and ncurses headers..."
            dnf groupinstall -y "Development Tools"
            dnf install -y ncurses-devel git
        elif [ -f /etc/arch-release ]; then
            echo -e "Arch Linux detected. Installing base-devel and ncurses..."
            sudo pacman -Syu --needed --noconfirm base-devel ncurses git
        else
            echo -e "${YELLOW}Unknown Linux distribution. Please ensure 'build-essential' and 'ncurses-dev' are installed manually.${NC}"
        fi
        ;;
    Darwin)
        echo -e "macOS detected. Checking for Xcode Command Line Tools..."
        if ! xcode-select -p &>/dev/null; then
            echo -e "${YELLOW}Xcode Command Line Tools not found. Installing...${NC}"
            xcode-select --install
            echo "Please complete the visual prompt installation before continuing. Press any key once done."
            read -n 1 -s
        fi
        
        if command -v brew &>/dev/null; then
            echo -e "Homebrew detected. Ensuring ncurses and git are installed..."
            brew install ncurses git
        else
            echo -e "${YELLOW}Warning: Homebrew is not installed. Native gems requiring ncurses might fail to build if headers are missing.${NC}"
        fi
        ;;
    *)
        echo -e "${RED}Unsupported OS: $OS. This script supports macOS and Linux.${NC}"
        exit 1
        ;;
esac

# 2. Check Ruby Environment
echo -e "\nChecking Ruby version..."
if ! command -v ruby &>/dev/null; then
    echo -e "${RED}Error: Ruby is not installed. Please install Ruby 3.1 or newer.${NC}"
    exit 1
fi

RUBY_VERSION=$(ruby -e 'print RUBY_VERSION')
RUBY_MAJOR=$(echo "$RUBY_VERSION" | cut -d. -f1)
RUBY_MINOR=$(echo "$RUBY_VERSION" | cut -d. -f2)

if [ "$RUBY_MAJOR" -lt 3 ] || { [ "$RUBY_MAJOR" -eq 3 ] && [ "$RUBY_MINOR" -lt 1 ]; }; then
    echo -e "${RED}Error: Tarantula requires Ruby 3.1 or newer. Current version: $RUBY_VERSION${NC}"
    exit 1
fi
echo -e "${GREEN}Ruby environment looks good! Version: $RUBY_VERSION${NC}"

# 3. Check/Install Bundler
if ! command -v bundle &>/dev/null; then
    echo -e "${YELLOW}Bundler not found. Installing bundler gem...${NC}"
    gem install bundler
else
    echo -e "${GREEN}Bundler is already installed.${NC}"
fi

# 4. Clone and Deploy Project
REPO_URL="https://github.com/yamln0proof/tarantula.git"
TARGET_DIR="tarantula"

if [ -d "$TARGET_DIR" ]; then
    echo -e "${YELLOW}Directory '$TARGET_DIR' already exists. Pulling latest shifts instead...${NC}"
    cd "$TARGET_DIR"
    git pull origin main
else
    echo -e "\nCloning Tarantula repository from $REPO_URL..."
    git clone "$REPO_URL" "$TARGET_DIR"
    cd "$TARGET_DIR"
fi

# 5. Run Local Setup Script
echo -e "\nRunning project setup script..."
echo -e "${YELLOW}bin/setup not found, running bundle install directly...${NC}"
bundle install

echo -e "\n${GREEN}==================================================${NC}"
echo -e "${GREEN}      Installation Completed Successfully!        ${NC}"
echo -e "${GREEN}==================================================${NC}"
echo -e "To start the Tarantula UI terminal application, execute:"
echo -e "${YELLOW}cd $(pwd) && bin/tarantula${NC}\n"
