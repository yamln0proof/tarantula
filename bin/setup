#!/usr/bin/env bash
set -Eeuo pipefail

log() {
  printf '\n[%s] %s\n' "$(date +%H:%M:%S)" "$*"
}

warn() {
  printf '\n[WARN] %s\n' "$*" >&2
}

die() {
  printf '\n[ERROR] %s\n' "$*" >&2
  exit 1
}

script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir/.."

ensure_sudo() {
  if [[ "$(id -u)" -ne 0 ]]; then
    echo "sudo"
  else
    echo ""
  fi
}

install_linux_dependencies() {
  local sudo_cmd
  sudo_cmd="$(ensure_sudo)"

  if command -v apt-get >/dev/null 2>&1; then
    log "Installing Linux build dependencies with apt-get"
    if [[ -n "$sudo_cmd" ]]; then
      $sudo_cmd apt-get update
      $sudo_cmd apt-get install -y build-essential libncurses-dev git
    else
      apt-get update
      apt-get install -y build-essential libncurses-dev git
    fi
    return 0
  fi

  if command -v dnf >/dev/null 2>&1; then
    log "Installing Linux build dependencies with dnf"
    if [[ -n "$sudo_cmd" ]]; then
      $sudo_cmd dnf install -y @development-tools ncurses-devel git
    else
      dnf install -y @development-tools ncurses-devel git
    fi
    return 0
  fi

  if command -v pacman >/dev/null 2>&1; then
    log "Installing Linux build dependencies with pacman"
    if [[ -n "$sudo_cmd" ]]; then
      $sudo_cmd pacman -Syu --needed --noconfirm base-devel ncurses git
    else
      pacman -Syu --needed --noconfirm base-devel ncurses git
    fi
    return 0
  fi

  warn "No supported package manager was found for this Linux system. Please install build-essential, ncurses development headers, and git manually."
  return 1
}

install_macos_dependencies() {
  if ! xcode-select -p >/dev/null 2>&1; then
    log "Installing Xcode Command Line Tools"
    xcode-select --install
    die "Xcode Command Line Tools were not available. Please complete the installation prompt and rerun this script."
  fi

  if command -v brew >/dev/null 2>&1; then
    log "Installing macOS dependencies with Homebrew"
    brew install ncurses git >/dev/null
  fi
}

check_ruby() {
  ruby -e 'abort "Ruby 3.1 or newer is required (found #{RUBY_VERSION})." if Gem::Version.new(RUBY_VERSION) < Gem::Version.new("3.1")'
}

main() {
  log "Preparing Tarantula environment"

  case "$(uname -s)" in
    Linux)
      install_linux_dependencies || die "Dependency installation failed. Install build tools and ncurses development headers manually, then rerun this script."
      ;;
    Darwin)
      install_macos_dependencies
      ;;
    *)
      die "This setup script supports Linux and macOS only."
      ;;
  esac

  command -v ruby >/dev/null 2>&1 || die "Ruby is required. Install Ruby 3.1 or newer and rerun this script."
  check_ruby

  if ! command -v bundle >/dev/null 2>&1; then
    log "Installing Bundler"
    gem install bundler
  fi

  log "Installing Ruby gems"
  bundle install --jobs 4 --retry 3

  log "Verifying Tarantula loads successfully"
  bundle exec ruby -Ilib -e 'require "tarantula"'

  log "Setup complete. Launch the app with: ./bin/tarantula"
}

main "$@"
