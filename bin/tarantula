#!/usr/bin/env ruby
# frozen_string_literal: true

project_root = File.expand_path("..", __dir__)
if File.file?(File.join(project_root, "Gemfile"))
  ENV["BUNDLE_GEMFILE"] ||= File.join(project_root, "Gemfile")
  require "bundler/setup"
else
  data_home = if ENV["XDG_DATA_HOME"]
                ENV["XDG_DATA_HOME"]
              elsif RUBY_PLATFORM.include?("darwin")
                File.join(Dir.home, "Library", "Application Support")
              else
                File.join(Dir.home, ".local", "share")
              end
  ENV["TARANTULA_DATABASE_PATH"] ||= File.join(data_home, "tarantula", "tarantula-crawls.json")
end

require "tarantula"

Tarantula.run
